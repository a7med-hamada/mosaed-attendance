{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "attendance.db"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/super-admin", "destination": "/super-admin/index.html" },
    { "source": "/super-admin/(.*)", "destination": "/super-admin/index.html" },
    { "source": "/owner", "destination": "/super-admin/index.html" },
    { "source": "/owner/(.*)", "destination": "/super-admin/index.html" },
    { "source": "/owner-portal", "destination": "/super-admin/index.html" },
    { "source": "/owner-portal/(.*)", "destination": "/super-admin/index.html" },
    { "source": "/admin-portal", "destination": "/super-admin/index.html" },
    { "source": "/admin-portal/(.*)", "destination": "/super-admin/index.html" }
  ]
}
